# Set to "false" to stop using dummy data and call your real APIs.
VITE_USE_MOCK=true

# Real endpoints (used only when VITE_USE_MOCK=false)
VITE_TELEMETRY_URL=/api/telemetry
VITE_ALERTS_URL=/api/alerts
VITE_VISION_URL=/api/inspect

# Poll interval for telemetry in milliseconds
VITE_POLL_MS=1000

# Dummy-data scenario: normal | warning | critical  (also works as ?scenario=warning in the URL)
VITE_MOCK_SCENARIO=normal
